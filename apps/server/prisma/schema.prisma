generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SearchHistory {
  id             String            @id @default(uuid())
  userId         String?
  searchQuery    String            @map("search_query")
  topK           Int               @map("top_k")
  appliedFilters Json?             @map("applied_filters")
  totalResults   Int               @map("total_results")
  searchLatency  Int               @map("search_latency")
  createdAt      DateTime          @default(now()) @map("created_at")

  retrievedPatents RetrievedPatent[]
  noveltyAnalysis  NoveltyAnalysis?

  @@index([searchQuery])
  @@index([createdAt])
  @@index([userId])
  @@map("search_histories")
}

model RetrievedPatent {
  id              String        @id @default(uuid())
  searchHistoryId String        @map("search_history_id")
  searchHistory   SearchHistory @relation(fields: [searchHistoryId], references: [id], onDelete: Cascade)
  patentId        String        @map("patent_id")
  title           String
  similarityScore Float         @map("similarity_score")
  ipc             String?
  country         String?
  publicationDate DateTime?     @map("publication_date")
  owner           String?
  metadata        Json?

  @@index([searchHistoryId])
  @@index([patentId])
  @@map("retrieved_patents")
}

model NoveltyAnalysis {
  id                String        @id @default(uuid())
  searchHistoryId   String        @unique @map("search_history_id")
  searchHistory     SearchHistory @relation(fields: [searchHistoryId], references: [id], onDelete: Cascade)
  summary           String        @db.Text
  novelty           String        @db.Text
  overlappingClaims Json          @map("overlapping_claims")
  recommendations   Json
  confidenceScore   Float         @map("confidence_score")
  rawLLMResponse    String        @db.Text @map("raw_llm_response")
  generatedAt       DateTime      @default(now()) @map("generated_at")

  @@map("novelty_analyses")
}

enum UploadStatus {
  Uploaded
  Processing
  Completed
  Failed
}

model UploadedDocument {
  id               String       @id @default(uuid())
  userId           String?      @map("user_id")
  originalFileName String       @map("original_file_name")
  storedFileName   String       @map("stored_file_name")
  mimeType         String       @map("mime_type")
  extension        String
  size             Int
  storagePath      String       @map("storage_path")
  uploadedAt       DateTime     @default(now()) @map("uploaded_at")
  status           UploadStatus @default(Uploaded)

  @@index([userId])
  @@index([uploadedAt])
  @@map("uploaded_documents")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Patent {
  id                 String    @id @default(uuid())
  patentNumber       String    @unique @map("patent_number")
  title              String
  abstract           String    @db.Text
  claims             String[]
  ipcClassifications String[]  @map("ipc_classifications")
  description        String?   @db.Text
  filingDate         DateTime? @map("filing_date")
  grantDate          DateTime? @map("grant_date")
  inventors          String[]
  assignee           String?
  cleanedAt          DateTime  @default(now()) @map("cleaned_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([patentNumber])
  @@index([title])
  @@map("patents")
}

model PatentabilityReport {
  id                      String   @id @default(uuid())
  patentId                String   @map("patent_id")
  title                   String
  overallNoveltyScore     Float    @map("overall_novelty_score")
  overallObviousnessScore Float    @map("overall_obviousness_score")
  summary                 String   @db.Text
  keyDifferences          String[] @map("key_differences")
  priorArtCitations       Json     @map("prior_art_citations")
  generatedAt             DateTime @default(now()) @map("generated_at")

  @@index([patentId])
  @@map("patentability_reports")
}



